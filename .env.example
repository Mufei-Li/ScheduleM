# 鉴权开关（true=开，false=关）
REQUIRE_AUTH=false
# 要求同域访问则为true
REQUIRE_SAME_ORIGIN=false
ALLOWED_ORIGINS=*
# 登录用户名
AUTH_USER=admin
# 登录密码（自己设个复杂的）
AUTH_PASS=your-password-here
# JWT密钥（随便写一串复杂字符）
JWT_SECRET=your-jwt-secret-here
# LLM API Key（在阿里云百炼控制台创建后填入）
LLM_API_KEY=sk-your-api-key-here
# LLM 模型（qwen3.7-flash：文本+图片统一）
LLM_MODEL=qwen3.7-flash
# PORT
PORT=3000
# PYTHON（本机 Python 解释器路径，用于 PDF 解析服务）
PYTHON_BIN=python
# PaddleOCR不检查源
DISABLE_MODEL_SOURCE_CHECK=True
